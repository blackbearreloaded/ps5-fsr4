//
// PS5 FSR4 Showcase: composes the 1920x1080 display frame. Each side of an
// optional split shows one source: the FSR4 output, a bilinear upscale of the
// jittered render or a native render at output size. Outputs larger than the
// display are box-filtered down. The lens magnifies output pixels around one
// point: a single circle, or for a split two circles side by side that show
// the same pixels from the left and the right source. The HUD overlay, drawn
// by the CPU as premultiplied RGBA8, goes on top after tone mapping.
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 0, rgba32f) uniform readonly image2D upscaled;
layout(set = 0, binding = 1, rgba16f) uniform readonly image2D rendered;
layout(set = 0, binding = 2, rgba16f) uniform readonly image2D native;
layout(set = 0, binding = 3, std430) readonly buffer Overlay { uint overlay[]; };
layout(set = 0, binding = 4, rgba8) uniform writeonly image2D frame;
layout(set = 0, binding = 5, std430) writeonly buffer Screenshot { uint pixels[]; };

layout(push_constant) uniform Params {
    ivec4 view;   // left source, right source, split x (display pixels), lens zoom (0: no lens)
    ivec4 lens;   // magnified point x, y (display pixels), lens radius, screenshot (1)
    ivec4 sizes;  // render width, height; output width, height
} p;

const int FSR4 = 0, BILINEAR = 1, NATIVE = 2;
const ivec2 DISPLAY = ivec2(1920, 1080);
const float LENS_GAP = 8.0;  // between the two circles of a split lens

// The render-resolution frame, bilinearly resampled at uv.
vec3 bilinear(vec2 uv)
{
    vec2 q = uv * vec2(p.sizes.xy) - 0.5;
    ivec2 i = ivec2(floor(q));
    vec2 f = q - vec2(i);
    ivec2 hi = p.sizes.xy - 1;
    vec3 a = imageLoad(rendered, clamp(i, ivec2(0), hi)).rgb;
    vec3 b = imageLoad(rendered, clamp(i + ivec2(1, 0), ivec2(0), hi)).rgb;
    vec3 c = imageLoad(rendered, clamp(i + ivec2(0, 1), ivec2(0), hi)).rgb;
    vec3 d = imageLoad(rendered, clamp(i + ivec2(1, 1), ivec2(0), hi)).rgb;
    return mix(mix(a, b, f.x), mix(c, d, f.x), f.y);
}

// One output-resolution pixel of a source.
vec3 output_texel(int source, ivec2 o)
{
    o = clamp(o, ivec2(0), p.sizes.zw - 1);
    if (source == FSR4) return imageLoad(upscaled, o).rgb;
    if (source == NATIVE) return imageLoad(native, o).rgb;
    return bilinear((vec2(o) + 0.5) / vec2(p.sizes.zw));
}

// A display pixel of a source: the output pixel itself at 1080p, else a 2x2 box
// filter over the output pixels it covers.
vec3 display_texel(int source, ivec2 q)
{
    if (p.sizes.zw == DISPLAY) return output_texel(source, q);
    if (source == BILINEAR) return bilinear((vec2(q) + 0.5) / vec2(DISPLAY));
    vec2 scale = vec2(p.sizes.zw) / vec2(DISPLAY);
    vec3 sum = vec3(0.0);
    for (int y = 0; y < 2; ++y)
        for (int x = 0; x < 2; ++x)
            sum += output_texel(source, ivec2((vec2(q) + (vec2(x, y) + 0.5) * 0.5) * scale));
    return sum * 0.25;
}

vec3 tonemap(vec3 c)
{
    c = max(c, 0.0);
    c = (c * (2.51 * c + 0.03)) / (c * (2.43 * c + 0.59) + 0.14);   // ACES fit, as the demo
    return mix(12.92 * c, 1.055 * pow(c, vec3(1.0 / 2.4)) - 0.055, step(0.0031308, c));
}

void main()
{
    ivec2 q = ivec2(gl_GlobalInvocationID.xy);
    if (q.x >= DISPLAY.x || q.y >= DISPLAY.y) return;
    int left = p.view.x, right = p.view.y, split = p.view.z, zoom = p.view.w;
    vec3 color;
    // The lens circle nearest to this pixel, and its source.
    float radius = float(p.lens.z);
    vec2 point = vec2(p.lens.xy) + 0.5;
    vec2 centre = point;
    int source = left;
    if (left != right) {
        float shift = radius + LENS_GAP * 0.5;
        bool on_right = float(q.x) + 0.5 >= point.x;
        centre.x += on_right ? shift : -shift;
        source = on_right ? right : left;
    }
    vec2 offset = vec2(q) + 0.5 - centre;
    float distance = zoom > 0 ? length(offset) : 1e9;
    if (distance < radius - 1.5) {
        // Output pixels around the magnified point, zoom display pixels each.
        vec2 o = point * vec2(p.sizes.zw) / vec2(DISPLAY) + offset / float(zoom);
        color = tonemap(output_texel(source, ivec2(floor(o))));
    } else if (distance < radius + 1.5) {
        color = vec3(1.0);                                          // the rim
    } else {
        color = tonemap(display_texel(q.x < split ? left : right, q));
        if (left != right && abs(q.x - split) < 1) color = vec3(1.0);
        color *= mix(0.55, 1.0, clamp((distance - radius - 1.5) / 14.0, 0.0, 1.0));  // lens shadow
    }
    color = clamp(color, 0.0, 1.0);
    vec4 hud = unpackUnorm4x8(overlay[q.y * DISPLAY.x + q.x]);
    color = hud.rgb + (1.0 - hud.a) * color;
    imageStore(frame, q, vec4(color, 1.0));
    if (p.lens.w != 0) {
        uvec3 c = uvec3(color * 255.0 + 0.5);
        pixels[q.y * DISPLAY.x + q.x] = c.b | (c.g << 8) | (c.r << 16) | (255u << 24);
    }
}
