//
// FSR4 demo presentation: tonemaps the 1080p FSR4 output (or a bilinear
// upscale of the render-resolution color, for comparison) into the RGBA8 frame
// that a full-screen draw copies into the VideoOut display image. Screenshot
// frames also write packed BGRA8 words for the host.
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 0, rgba32f) uniform readonly image2D upscaled;
layout(set = 0, binding = 1, rgba16f) uniform readonly image2D rendered;
layout(set = 0, binding = 2, std430) writeonly buffer Screenshot { uint pixels[]; };
layout(set = 0, binding = 3, rgba8) uniform writeonly image2D frame;

layout(push_constant) uniform Params {
    vec4 view;   // mode (0 FSR4, 1 split, 2 bilinear), split position, render width, render height
    vec4 status; // FSR4 milliseconds, frame milliseconds, screenshot (1), 0
} p;

const ivec2 OUTPUT = ivec2(1920, 1080);

vec3 bilinear(vec2 uv)
{
    vec2 size = p.view.zw;
    vec2 q = uv * size - 0.5;
    ivec2 i = ivec2(floor(q));
    vec2 f = q - vec2(i);
    ivec2 hi = ivec2(size) - 1;
    vec3 a = imageLoad(rendered, clamp(i, ivec2(0), hi)).rgb;
    vec3 b = imageLoad(rendered, clamp(i + ivec2(1, 0), ivec2(0), hi)).rgb;
    vec3 c = imageLoad(rendered, clamp(i + ivec2(0, 1), ivec2(0), hi)).rgb;
    vec3 d = imageLoad(rendered, clamp(i + ivec2(1, 1), ivec2(0), hi)).rgb;
    return mix(mix(a, b, f.x), mix(c, d, f.x), f.y);
}

vec3 tonemap(vec3 c)
{
    c = max(c, 0.0);
    c = (c * (2.51 * c + 0.03)) / (c * (2.43 * c + 0.59) + 0.14);   // ACES fit
    return mix(12.92 * c, 1.055 * pow(c, vec3(1.0 / 2.4)) - 0.055, step(0.0031308, c));
}

// A bar per timing: 1 pixel per 0.1 ms, 16.7 ms marked.
bool bar(ivec2 q, int row, float ms, out vec3 color)
{
    if (q.y < 20 + row * 14 || q.y >= 30 + row * 14 || q.x < 20 || q.x >= 20 + 400) return false;
    int x = q.x - 20;
    color = x == 167 ? vec3(1.0) : (float(x) < ms * 10.0 ? (row == 0 ? vec3(0.1, 0.9, 0.3) : vec3(0.9, 0.7, 0.1))
                                                         : vec3(0.08));
    return true;
}

void main()
{
    ivec2 q = ivec2(gl_GlobalInvocationID.xy);
    if (q.x >= OUTPUT.x || q.y >= OUTPUT.y) return;
    vec2 uv = (vec2(q) + 0.5) / vec2(OUTPUT);
    int mode = int(p.view.x + 0.5);
    bool fsr = mode == 0 || (mode == 1 && float(q.x) >= p.view.y);
    vec3 color = fsr ? imageLoad(upscaled, q).rgb : bilinear(uv);
    color = tonemap(color);
    if (mode == 1 && abs(float(q.x) - p.view.y) < 1.5) color = vec3(1.0);
    vec3 overlay;
    if (bar(q, 0, p.status.x, overlay) || bar(q, 1, p.status.y, overlay)) color = overlay;
    color = clamp(color, 0.0, 1.0);
    imageStore(frame, q, vec4(color, 1.0));
    if (p.status.z > 0.5) {
        uvec3 c = uvec3(color * 255.0 + 0.5);
        pixels[q.y * OUTPUT.x + q.x] = c.b | (c.g << 8) | (c.r << 16) | (255u << 24);
    }
}
