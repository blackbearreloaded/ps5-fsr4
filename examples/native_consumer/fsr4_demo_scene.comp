//
// FSR4 demo scene: a ray-marched set with deliberately alias-prone detail
// (thin grid lines, fence bars, pillars) rendered at render resolution with
// sub-pixel jitter. Writes linear HDR color, D3D-style depth and motion
// vectors (previous minus current UV, excluding jitter) as FSR4 expects.
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 0, rgba16f) uniform writeonly image2D color_out;
layout(set = 0, binding = 1, r32f) uniform writeonly image2D depth_out;
layout(set = 0, binding = 2, rgba32f) uniform writeonly image2D motion_out;

layout(push_constant) uniform Params {
    vec4 camera;       // yaw, pitch, distance, time
    vec4 previous;     // the previous frame's camera
    vec4 frame;        // jitter x, jitter y (render pixels), render width, render height
} p;

const float NEAR = 0.1, FAR = 200.0, FOV = 1.0471976;
const vec3 TARGET = vec3(0.0, 1.2, 0.0);
const vec3 ROTOR = vec3(3.5, 1.6, -1.0);

struct Camera { vec3 origin, forward, right, up; };

Camera orbit(vec4 c)
{
    vec3 origin = TARGET + c.z * vec3(cos(c.y) * cos(c.x), sin(c.y), cos(c.y) * sin(c.x));
    vec3 forward = normalize(TARGET - origin);
    vec3 right = normalize(cross(forward, vec3(0.0, 1.0, 0.0)));
    return Camera(origin, forward, right, cross(right, forward));
}

mat2 rotation(float a) { float c = cos(a), s = sin(a); return mat2(c, -s, s, c); }
float rotor_angle(float t) { return t * 1.7; }

float box(vec3 q, vec3 b) { vec3 d = abs(q) - b; return length(max(d, 0.0)) + min(max(d.x, max(d.y, d.z)), 0.0); }

// Distance and material id; the rotor is evaluated in its own frame at time t.
vec2 scene(vec3 q, float t)
{
    vec2 hit = vec2(q.y, 1.0);                                        // ground
    float spheres = min(length(q - vec3(-2.0, 1.0, 1.5)) - 1.0, length(q - vec3(1.2, 0.6, 2.4)) - 0.6);
    if (spheres < hit.x) hit = vec2(spheres, 2.0);
    vec3 c = q; c.xz = mod(c.xz + 3.0, 6.0) - 3.0;                    // pillars on a 6 m lattice
    float pillar = max(length(c.xz) - 0.18, q.y - 4.0);
    if (pillar < hit.x) hit = vec2(pillar, 3.0);
    vec3 f = q - vec3(0.0, 0.0, -4.0); f.x = mod(f.x + 0.25, 0.5) - 0.25; // fence of thin bars
    float fence = max(box(f, vec3(0.025, 1.4, 0.025)), abs(q.x) - 7.0);
    float rail = max(box(q - vec3(0.0, 1.35, -4.0), vec3(7.0, 0.03, 0.03)), 0.0);
    if (min(fence, rail) < hit.x) hit = vec2(min(fence, rail), 4.0);
    vec3 r = q - ROTOR; r.xy = rotation(rotor_angle(t)) * r.xy;       // spinning rotor
    float blades = min(box(r, vec3(1.2, 0.06, 0.12)), box(r, vec3(0.06, 1.2, 0.12)));
    if (blades < hit.x) hit = vec2(blades, 5.0);
    return hit;
}

vec3 normal_at(vec3 q, float t)
{
    const vec2 e = vec2(1e-3, 0.0);
    return normalize(vec3(scene(q + e.xyy, t).x - scene(q - e.xyy, t).x,
                          scene(q + e.yxy, t).x - scene(q - e.yxy, t).x,
                          scene(q + e.yyx, t).x - scene(q - e.yyx, t).x));
}

vec3 albedo(vec3 q, float id)
{
    if (id < 1.5) {                                                   // checker with thin grid lines
        vec2 g = q.xz;
        float checker = mod(floor(g.x) + floor(g.y), 2.0);
        vec2 line = abs(fract(g * 4.0) - 0.5);
        float grid = step(0.46, max(line.x, line.y));
        return mix(vec3(0.18) + 0.5 * checker, vec3(0.9, 0.85, 0.2), grid);
    }
    if (id < 2.5) return vec3(0.8, 0.25, 0.2);
    if (id < 3.5) return vec3(0.75) * (0.6 + 0.4 * step(0.5, fract(q.y * 3.0)));
    if (id < 4.5) return vec3(0.15, 0.6, 0.9);
    return vec3(0.95, 0.5, 0.1);
}

vec3 sky(vec3 d) { return mix(vec3(0.9, 0.95, 1.1), vec3(0.25, 0.45, 0.9), clamp(d.y, 0.0, 1.0)) * 1.5; }

// Screen UV of a world point for a camera (no jitter).
vec2 project(Camera c, vec3 q, vec2 size)
{
    vec3 v = q - c.origin;
    float z = dot(v, c.forward);
    float h = tan(FOV * 0.5), aspect = size.x / size.y;
    vec2 ndc = vec2(dot(v, c.right) / (z * h * aspect), dot(v, c.up) / (z * h));
    return vec2(ndc.x * 0.5 + 0.5, 0.5 - ndc.y * 0.5);
}

void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    vec2 size = p.frame.zw;
    if (pixel.x >= int(size.x) || pixel.y >= int(size.y)) return;
    Camera cam = orbit(p.camera);
    float t = p.camera.w;
    // FidelityFX convention: the projection is offset by +jitter, so a pixel samples center - jitter.
    vec2 sample_uv = (vec2(pixel) + 0.5 - p.frame.xy) / size;
    float h = tan(FOV * 0.5), aspect = size.x / size.y;
    vec2 ndc = vec2(sample_uv.x * 2.0 - 1.0, 1.0 - sample_uv.y * 2.0);
    vec3 dir = normalize(cam.forward + cam.right * ndc.x * h * aspect + cam.up * ndc.y * h);

    float travel = NEAR, id = 0.0;
    for (int i = 0; i < 160 && travel < FAR; ++i) {
        vec2 s = scene(cam.origin + dir * travel, t);
        if (s.x < 1e-3 * travel) { id = s.y; break; }
        travel += s.x;
    }
    vec3 color, hit = cam.origin + dir * travel;
    float depth = 1.0;
    vec2 motion = vec2(0.0);
    if (id > 0.0) {
        vec3 n = normal_at(hit, t);
        vec3 light = normalize(vec3(0.5, 0.8, 0.3));
        float shadow = 1.0, s = 0.02;
        for (int i = 0; i < 48 && s < 20.0; ++i) {
            float d = scene(hit + n * 2e-3 + light * s, t).x;
            shadow = min(shadow, 12.0 * d / s);
            s += clamp(d, 0.02, 0.5);
        }
        shadow = clamp(shadow, 0.0, 1.0);
        vec3 base = albedo(hit, id);
        vec3 h_vec = normalize(light - dir);
        float spec = pow(max(dot(n, h_vec), 0.0), 64.0) * shadow;
        color = base * (0.15 * sky(n) + 2.4 * max(dot(n, light), 0.0) * shadow) + 4.0 * spec;
        color = mix(color, sky(dir), 1.0 - exp(-0.004 * travel * travel * 0.02));
        float z = dot(hit - cam.origin, cam.forward);
        depth = (FAR / (FAR - NEAR)) * (1.0 - NEAR / z);
        vec3 prev_hit = hit;
        if (id > 4.5) {                                              // the rotor moved since last frame
            vec3 r = hit - ROTOR;
            r.xy = rotation(rotor_angle(t)) * r.xy;
            r.xy = rotation(-rotor_angle(p.previous.w)) * r.xy;
            prev_hit = ROTOR + r;
        }
        Camera previous = orbit(p.previous);
        motion = project(previous, prev_hit, size) - project(cam, hit, size);
    } else {
        color = sky(dir);
        Camera previous = orbit(p.previous);
        motion = project(previous, cam.origin + dir * FAR, size) - project(cam, cam.origin + dir * FAR, size);
    }
    imageStore(color_out, pixel, vec4(color, 1.0));
    imageStore(depth_out, pixel, vec4(depth));
    imageStore(motion_out, pixel, vec4(motion, 0.0, 0.0));
}
