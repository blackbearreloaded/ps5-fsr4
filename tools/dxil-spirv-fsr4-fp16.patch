+#ifdef PS5_FSR4_REFERENCE_FP16
+// A texture-result convert/extend pair can retain FP32 precision on Vulkan.
+// Quantize normal values explicitly; round the subnormal interval in FP32
+// because OpQuantizeToF16 is permitted to flush FP16 subnormals to zero.
+static spv::Id fsr4_rte_fp16_input(Converter::Impl &impl, spv::Id input, unsigned components)
+{
+    auto &b = impl.builder();
+    auto type = [&](spv::Id scalar) {
+        return components == 1 ? scalar : b.makeVectorType(scalar, components);
+    };
+    auto constant = [&](spv::Id scalar, spv::Id scalar_type) {
+        return components == 1 ? scalar :
+            b.makeCompositeConstant(type(scalar_type), Vector<spv::Id>(components, scalar));
+    };
+    auto u32 = type(b.makeUintType(32));
+    auto f32 = type(b.makeFloatType(32));
+    auto boolean = type(b.makeBoolType());
+    auto u = [&](uint32_t value) { return constant(b.makeUintConstant(value), b.makeUintType(32)); };
+    auto f = [&](float value) { return constant(b.makeFloatConstant(value), b.makeFloatType(32)); };
+    auto op = [&](spv::Op code, spv::Id result_type, std::initializer_list<spv::Id> ids) {
+        auto *value = impl.allocate(code, result_type);
+        for (auto id : ids) value->add_id(id);
+        impl.add(value);
+        return value->id;
+    };
+    auto bits = op(spv::OpBitcast, u32, {input});
+    auto magnitude = op(spv::OpBitwiseAnd, u32, {bits, u(0x7fffffffu)});
+    auto small = op(spv::OpULessThan, boolean, {magnitude, u(0x38800000u)});
+    auto scaled = op(spv::OpFMul, f32, {op(spv::OpBitcast, f32, {magnitude}), f(16777216.0f)});
+    if (!impl.glsl_std450_ext)
+        impl.glsl_std450_ext = b.import("GLSL.std.450");
+    auto *round = impl.allocate(spv::OpExtInst, f32);
+    round->add_id(impl.glsl_std450_ext);
+    round->add_literal(GLSLstd450RoundEven);
+    round->add_id(scaled);
+    impl.add(round);
+    auto subnormal = op(spv::OpFMul, f32, {round->id, f(0x1p-24f)});
+    auto signed_bits = op(spv::OpBitwiseOr, u32, {
+        op(spv::OpBitcast, u32, {subnormal}),
+        op(spv::OpBitwiseAnd, u32, {bits, u(0x80000000u)})});
+    auto quantized = op(spv::OpQuantizeToF16, f32, {input});
+    return op(spv::OpSelect, f32, {small, op(spv::OpBitcast, f32, {signed_bits}), quantized});
+}
+#endif
