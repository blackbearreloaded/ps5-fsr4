+#ifdef PS5_FSR4_REFERENCE_FP16
+// The captured reference contracts FP32 sums in operand order. Make that
+// choice explicit instead of letting each Vulkan compiler select a different
+// multiply to fuse. Keep precise operations and FP16 arithmetic unchanged.
+static spv::Id fsr4_contract_fp32_add(Converter::Impl &impl, const llvm::BinaryOperator *instruction)
+{
+    const char *policy = std::getenv("PS5_FSR4_FP32_FMA");
+    if (policy && policy[0] == '0' && policy[1] == 0)
+        return 0;
+    if (impl.options.force_precise || !instruction->isFast() ||
+        instruction->getOpcode() != llvm::Instruction::FAdd ||
+        instruction->getType()->getTypeID() != llvm::Type::TypeID::FloatTyID)
+        return 0;
+
+    for (unsigned side = 0; side < 2; side++)
+    {
+        const auto *mul = llvm::dyn_cast<llvm::BinaryOperator>(instruction->getOperand(side));
+        if (!mul || mul->getOpcode() != llvm::Instruction::FMul || !mul->isFast())
+            continue;
+
+        if (!impl.glsl_std450_ext)
+            impl.glsl_std450_ext = impl.builder().import("GLSL.std.450");
+        auto *op = impl.allocate(spv::OpExtInst, instruction);
+        op->add_id(impl.glsl_std450_ext);
+        op->add_literal(GLSLstd450Fma);
+        op->add_id(impl.get_id_for_value(mul->getOperand(0)));
+        op->add_id(impl.get_id_for_value(mul->getOperand(1)));
+        op->add_id(impl.get_id_for_value(instruction->getOperand(1 - side)));
+        impl.add(op);
+        add_nocontract_decoration(impl, op->id);
+        return op->id;
+    }
+    return 0;
+}
+
+static spv::Id fsr4_contract_fp32_add(Converter::Impl &, const llvm::ConstantExpr *)
+{
+    return 0;
+}
+#endif
