+#ifdef PS5_FSR4_REFERENCE_FP16
+// Match the captured D3D12 reference's scalar FP32 -> FP16 RTZ conversion.
+// Mask in FP32 before conversion: a convert/extend/compare correction can be
+// folded away by Vulkan drivers. Every finite result below is exactly FP16
+// representable, including subnormals, signed zero and overflow saturation.
+static spv::Id fsr4_rtz_fp16_input(Converter::Impl &impl, spv::Id input)
+{
+    auto &b = impl.builder();
+    auto u32 = b.makeUintType(32);
+    auto f32 = b.makeFloatType(32);
+    auto boolean = b.makeBoolType();
+    auto c = [&](uint32_t value) { return b.makeUintConstant(value); };
+    auto op = [&](spv::Op code, spv::Id type, std::initializer_list<spv::Id> ids) {
+        auto *value = impl.allocate(code, type);
+        for (auto id : ids) value->add_id(id);
+        impl.add(value);
+        return value->id;
+    };
+    auto bits = op(spv::OpBitcast, u32, {input});
+    auto sign = op(spv::OpBitwiseAnd, u32, {bits, c(0x80000000u)});
+    auto exponent = op(spv::OpBitwiseAnd, u32,
+        {op(spv::OpShiftRightLogical, u32, {bits, c(23)}), c(255)});
+    auto subnormal = op(spv::OpULessThan, boolean, {exponent, c(113)});
+    auto shift = op(spv::OpBitwiseAnd, u32,
+        {op(spv::OpISub, u32, {c(126), exponent}), c(31)});
+    shift = op(spv::OpSelect, u32, {subnormal, shift, c(13)});
+    auto mask = op(spv::OpShiftLeftLogical, u32, {c(0xffffffffu), shift});
+    auto truncated = op(spv::OpBitwiseAnd, u32, {bits, mask});
+    auto tiny = op(spv::OpULessThan, boolean, {exponent, c(103)});
+    truncated = op(spv::OpSelect, u32, {tiny, sign, truncated});
+    auto overflow = op(spv::OpUGreaterThan, boolean, {exponent, c(142)});
+    auto largest = op(spv::OpBitwiseOr, u32, {sign, c(0x477fe000u)});
+    truncated = op(spv::OpSelect, u32, {overflow, largest, truncated});
+    auto special = op(spv::OpIEqual, boolean, {exponent, c(255)});
+    truncated = op(spv::OpSelect, u32, {special, bits, truncated});
+    return op(spv::OpBitcast, f32, {truncated});
+}
+#endif
