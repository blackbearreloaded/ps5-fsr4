+#ifdef PS5_FSR4_REFERENCE_FP16
+// Match the captured D3D12 reference's scalar FP32 -> FP16 RTZ conversion.
+// Round to nearest even in FP16, then step the result one unit toward zero
+// where that rounding increased the magnitude. This is RTZ for subnormals,
+// signed zero and NaN too, and an overflowing infinity steps back to the
+// largest finite value. The FP32 result is exactly FP16-representable.
+static spv::Id fsr4_rtz_fp16_input(Converter::Impl &impl, spv::Id input)
+{
+    auto &b = impl.builder();
+    b.addCapability(spv::CapabilityFloat16);
+    b.addCapability(spv::CapabilityInt16);
+    auto f16 = b.makeFloatType(16);
+    auto f32 = b.makeFloatType(32);
+    auto u16 = b.makeUintType(16);
+    auto op = [&](spv::Op code, spv::Id type, std::initializer_list<spv::Id> ids) {
+        auto *value = impl.allocate(code, type);
+        for (auto id : ids) value->add_id(id);
+        impl.add(value);
+        return value->id;
+    };
+    if (!impl.glsl_std450_ext)
+        impl.glsl_std450_ext = b.import("GLSL.std.450");
+    auto abs = [&](spv::Id value) {
+        auto *fabs = impl.allocate(spv::OpExtInst, f32);
+        fabs->add_id(impl.glsl_std450_ext);
+        fabs->add_literal(GLSLstd450FAbs);
+        fabs->add_id(value);
+        impl.add(fabs);
+        return fabs->id;
+    };
+    auto nearest = op(spv::OpFConvert, f16, {input});
+    auto extended = op(spv::OpFConvert, f32, {nearest});
+    add_nocontract_decoration(impl, extended);
+    auto grew = op(spv::OpFOrdGreaterThan, b.makeBoolType(), {abs(extended), abs(input)});
+    auto step = op(spv::OpSelect, u16, {grew, b.makeUint16Constant(1), b.makeUint16Constant(0)});
+    auto bits = op(spv::OpISub, u16, {op(spv::OpBitcast, u16, {nearest}), step});
+    auto result = op(spv::OpFConvert, f32, {op(spv::OpBitcast, f16, {bits})});
+    add_nocontract_decoration(impl, result);
+    return result;
+}
+#endif
